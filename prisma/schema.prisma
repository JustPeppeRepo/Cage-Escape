// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum BookingStatus {
  PENDING
  DEPOSIT_PAID
  PAID
  CANCELLED
  COMPLETED
  PAYMENT_CONFLICT_REFUND_REQUIRED
}

enum PaymentType {
  DEPOSIT
  BALANCE
  FULL
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum ScheduleOverrideType {
  CLOSED
  CUSTOM_HOURS
}

model User {
  id                  String    @id @default(uuid())
  name                String
  email               String    @unique
  emailVerified       Boolean   @default(false)
  image               String?   @default("https://cageroom.avatar")
  role                Role      @default(USER)
  username            String    @unique
  phone               String
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now()) @db.Timestamptz
  updatedAt           DateTime  @updatedAt @db.Timestamptz
  bookings            Booking[]
  sessions            Session[]
  accounts            Account[]
  discountCodes       DiscountCode[]

  @@map("user")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Room {
  id              String             @id @default(cuid())
  slug            String             @unique
  name            String
  description     String
  // Prezzo indicativo "a partire da", usato solo per la visualizzazione nelle
  // card di listing. Il prezzo effettivo addebitato dipende dal numero di
  // partecipanti ed e risolto tramite RoomPricingTier.
  prezzoTotale    Decimal
  prezzoCaparra   Decimal
  durationMinutes Int
  minPlayers      Int
  maxPlayers      Int
  terrorLevel     Int                @default(3)
  isActive        Boolean            @default(true)
  // Cover ottimizzata (WebP via Sharp in upload). Non selezionare in listing.
  imageWebp       Bytes?
  imageUpdatedAt  DateTime?          @db.Timestamptz
  createdAt       DateTime           @default(now()) @db.Timestamptz
  updatedAt       DateTime           @updatedAt @db.Timestamptz
  bookings        Booking[]
  scheduleOverrides ScheduleOverride[]
  pricingTiers    RoomPricingTier[]
}

model RoomPricingTier {
  id              String   @id @default(cuid())
  roomId          String
  room            Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  minParticipants Int
  maxParticipants Int
  totalPrice      Decimal
  depositPrice    Decimal
  createdAt       DateTime @default(now()) @db.Timestamptz
  updatedAt       DateTime @updatedAt @db.Timestamptz

  @@unique([roomId, minParticipants, maxParticipants])
  @@index([roomId])
}

model ScheduleOverride {
  id        String               @id @default(cuid())
  date      DateTime             @db.Date
  roomId    String?
  room      Room?                @relation(fields: [roomId], references: [id])
  type      ScheduleOverrideType
  openHour  Int?
  closeHour Int?
  reason    String?
  createdAt DateTime             @default(now()) @db.Timestamptz
  updatedAt DateTime             @updatedAt @db.Timestamptz

  @@unique([date, roomId])
  @@index([date])
}

// Orari di apertura settimanali di default (0 = lunedì … 6 = domenica).
// Gli override su ScheduleOverride hanno priorità su queste regole.
model WeeklyOpeningHours {
  id        String   @id @default(cuid())
  dayOfWeek Int      @unique
  isOpen    Boolean  @default(true)
  openHour  Int      @default(10)
  closeHour Int      @default(22)
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model Booking {
  id              String        @id @default(cuid())
  user            User          @relation(fields: [userId], references: [id])
  userId          String
  room            Room          @relation(fields: [roomId], references: [id])
  roomId          String
  startTime       DateTime      @db.Timestamptz
  endTime         DateTime      @db.Timestamptz
  totalAmount     Decimal
  status          BookingStatus @default(PENDING)
  holdExpiresAt   DateTime?     @db.Timestamptz
  stripeSessionId String?       @unique
  paymentChoice   PaymentType
  participantCount Int
  minorCount      Int           @default(0)
  discountCodeId  String?
  discountCode    DiscountCode? @relation(fields: [discountCodeId], references: [id])
  payments        Payment[]
  waivers         BookingWaiver[]
  createdAt       DateTime      @default(now()) @db.Timestamptz

  @@index([startTime, endTime])
  @@index([roomId, startTime, endTime])
  @@index([holdExpiresAt])
}

model BookingWaiver {
  id         String   @id @default(cuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  minorIndex Int
  fileName   String
  mimeType   String
  sizeBytes  Int
  content    Bytes
  uploadedAt DateTime @default(now()) @db.Timestamptz

  @@unique([bookingId, minorIndex])
  @@index([bookingId])
}

model Payment {
  id              String        @id @default(cuid())
  booking         Booking       @relation(fields: [bookingId], references: [id])
  bookingId       String
  stripePaymentId String        @unique
  amount          Decimal
  type            PaymentType
  status          PaymentStatus @default(PENDING)
  paidAt          DateTime?     @db.Timestamptz
}

// Riga singola di configurazione globale (id fisso "default").
model SiteSettings {
  id                       String   @id @default("default")
  easterEggDiscountEnabled Boolean  @default(false)
  easterEggDiscountPercent Int      @default(5)
  /// Minuti di buffer tra fine di una sessione e inizio della successiva (stessa stanza).
  slotCooldownMinutes       Int      @default(15)
  updatedAt                DateTime @updatedAt @db.Timestamptz
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([createdAt])
}

model DiscountCode {
  id              String    @id @default(cuid())
  code            String    @unique
  discountPercent Int
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  used            Boolean   @default(false)
  usedAt          DateTime? @db.Timestamptz
  expiresAt       DateTime  @db.Timestamptz
  createdAt       DateTime  @default(now()) @db.Timestamptz
  bookings        Booking[]

  @@index([userId])
  @@index([code])
}

model Review {
  id             String    @id @default(cuid())
  author         String
  quote          String
  rotation       Int       @default(0)
  sortOrder      Int       @default(0)
  isPublished    Boolean   @default(true)
  // Cover ottimizzata (WebP via Sharp in upload). Non selezionare in listing.
  imageWebp      Bytes?
  imageUpdatedAt DateTime? @db.Timestamptz
  createdAt      DateTime  @default(now()) @db.Timestamptz
  updatedAt      DateTime  @updatedAt @db.Timestamptz

  @@index([isPublished, sortOrder])
}

// Contatore condiviso per rate limiting distribuito (finestra fissa 60s).
// Usa lo stesso Neon Postgres del resto dell'app: niente servizio Redis
// esterno. Le righe scadute vengono riutilizzate al successivo hit sulla
// stessa chiave (login, signup, hold, ecc.).
model RateLimitCounter {
  key     String   @id
  count   Int      @default(1)
  resetAt DateTime @db.Timestamptz

  @@index([resetAt])
}

// Idempotenza webhook Stripe: event.id univoco. I retry di Stripe
// (stesso evt_...) devono tornare 200 senza rieseguire mutazioni.
model StripeWebhookEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([type])
  @@map("stripe_webhook_event")
}
