# =============================================================================
# Cage Escape Room — variabili d'ambiente
# Copia questo file in `.env` (locale) e compila i valori.
# Su Vercel: Project → Settings → Environment Variables (Production / Preview / Development).
# Validazione runtime: src/app/_lib/env.ts
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# URL pubblico del sito. In produzione usa il dominio reale (https://cageroom.it),
# NON *.vercel.app: altrimenti callback auth, reset password e Stripe success
# puntano al dominio sbagliato e i cookie di sessione non valgono.
# Locale: http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Database (Prisma)
# Dove: se usi Postgres di Supabase → Dashboard → Project Settings → Database
#   → Connection string → URI.
#   - Runtime (Vercel/serverless): Transaction pooler (porta 6543), spesso con
#     `?pgbouncer=true` se Prisma lo richiede.
#   - Migrazioni (`prisma migrate`): Direct connection (porta 5432).
#   In locale puoi usare la Direct connection per entrambi.
# Alternativa: Neon / altro host Postgres → connection string dal relativo dashboard.
# Formato: postgresql://USER:PASSWORD@HOST:PORT/postgres?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# -----------------------------------------------------------------------------
# Supabase Auth (obbligatorie)
# Dove: Dashboard → Project Settings → API
#   https://supabase.com/dashboard/project/_/settings/api
#   - Project URL          → NEXT_PUBLIC_SUPABASE_URL
#   - Project API keys → `anon` `public`  → NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# Config Auth (redirect PKCE / reset password) — NON sono env, si impostano in dashboard:
#   Authentication → URL Configuration
#     Site URL: stesso valore di NEXT_PUBLIC_APP_URL
#     Redirect URLs (allow list), almeno:
#       http://localhost:3000/auth/callback
#       https://TUO-DOMINIO/auth/callback
#   Authentication → Emails: template conferma / reset (inviati da Supabase).
#   Opzionale: Authentication → SMTP → punta a Resend se vuoi brandizzare le mail Auth.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_ME"

# Service role: Dashboard → Project Settings → API → `service_role` (SECRET).
# NON usata dal codice applicativo (Prisma parla al DB in diretta).
# NON decommentare. NON prefissare con NEXT_PUBLIC_. Bypass totale RLS.
# SUPABASE_SERVICE_ROLE_KEY=""

# -----------------------------------------------------------------------------
# Vercel Cron keep-alive (obbligatoria in produzione)
# Dove: la generi TU, poi la incolli in Vercel → Settings → Environment Variables.
#   Nome: CRON_SECRET
#   Valore: stringa casuale >= 32 caratteri (es. `openssl rand -hex 32`).
# Vercel, per i cron definiti in vercel.json, invia automaticamente
#   Authorization: Bearer <CRON_SECRET>
# verso /api/cron/keep-alive (ogni 5 giorni). Senza questa env la route risponde 401.
# Locale: opzionale (il cron non gira); in prod Vercel e' obbligatoria.
CRON_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# -----------------------------------------------------------------------------
# Stripe
# Dove: https://dashboard.stripe.com/apikeys  (test) oppure /apikeys in live mode
#   Secret key → STRIPE_SECRET_KEY  (sk_test_... / sk_live_..., ammesse anche rk_)
# Webhook signing secret:
#   Produzione: Developers → Webhooks → endpoint
#     https://TUO-DOMINIO/api/webhook/stripe  (alias: /api/webhooks/stripe)
#     → Signing secret whsec_...
#   Locale: `stripe listen --forward-to localhost:3000/api/webhook/stripe`
#     stampa un whsec_ da usare solo in .env locale.
STRIPE_SECRET_KEY="sk_test_REPLACE_ME"
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_ME"

# -----------------------------------------------------------------------------
# Email transazionali (Resend) — contatti + alert ops Stripe
# Le email di Auth (conferma signup, reset password) le invia Supabase, non Resend,
# a meno che tu non configuri SMTP custom in Supabase → Authentication → SMTP.
# Dove: https://resend.com/api-keys
# From: https://resend.com/domains  (dominio verificato, es. noreply@cageroom.it)
# Obbligatorie in produzione. In locale puoi lasciarle vuote (form contatti non spedira').
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
CONTACT_EMAIL_TO=""
# Alert staff su conflitti/rimborsi Stripe. Se vuota, fallback su CONTACT_EMAIL_TO.
STRIPE_OPS_EMAIL_TO=""

# -----------------------------------------------------------------------------
# iubenda (opzionali) — cookie banner + link privacy/termini
# Dove: dashboard iubenda → embed / Site ID e ID dei documenti.
NEXT_PUBLIC_IUBENDA_SITE_ID=""
NEXT_PUBLIC_IUBENDA_PRIVACY_POLICY_ID=""
NEXT_PUBLIC_IUBENDA_TERMS_ID=""

# -----------------------------------------------------------------------------
# Impostate automaticamente — non copiare in .env locale
# NODE_ENV          → development | production | test (Next.js)
# VERCEL_ENV        → production | preview | development (solo su Vercel)
#                     Usata per manutenzione fail-closed e rate-limit.

# -----------------------------------------------------------------------------
# Solo script di audit (opzionali)
# npx tsx scripts/audit-stripe-payment-flows.ts
# AUDIT_WEBHOOK_URL="http://localhost:3000/api/webhook/stripe"
# AUDIT_WEBHOOK_ALIAS_URL="http://localhost:3000/api/webhooks/stripe"

# -----------------------------------------------------------------------------
